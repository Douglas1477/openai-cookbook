{
    "name": "Terminal Minimalista Root",
    // Usamos uma imagem base leve do Ubuntu
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    
    "features": {
        // Instala o Python 3 de forma otimizada
        "ghcr.io/devcontainers/features/python:1": {
            "version": "latest"
        },
        // Adiciona ferramentas comuns de terminal (Git, curl, etc)
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": false,
            "upgradePackages": true
        }
    },

    // 1. CONFIGURAÇÃO DE PRIVILÉGIOS (Inicia direto como Root)
    "remoteUser": "root",
    "containerUser": "root",

    // 2. INSTALAÇÃO DO KVM E TOOLS (No boot do container)
    "postCreateCommand": "apt-get update && apt-get install -y qemu-system-x86 qemu-utils cpu-checker && echo 'alias kvm=\"qemu-system-x86_64\"' >> /root/.bashrc",

    "customizations": {
        "vscode": {
            // Extensões mínimas para não pesar na RAM
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    // 3. ARGUMENTOS PARA TENTAR ACESSO AO HARDWARE
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "--device", "/dev/kvm:/dev/kvm"
    ]
}
